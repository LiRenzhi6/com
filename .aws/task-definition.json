{
  "family": "flight-client-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::381492153714:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "flight-client",
      "image": "381492153714.dkr.ecr.ap-northeast-1.amazonaws.com/renzhi/flightfront:9cffbffde369cbe9eb3c2c5650e519f565e56cf3",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
